{
  "name": "sporlys-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node tools/test-all.mjs",
    "build:web": "node tools/build-native.mjs",
    "prepare:android": "npm run build:web && node tools/prepare-android.mjs",
    "build:apk": "npm run prepare:android && cd android && ./gradlew :app:assembleDebug",
    "build:aab": "npm run prepare:android:release && cd android && ./gradlew :app:bundleRelease",
    "build:apk:optimized": "npm run prepare:android && cd android && ./gradlew -PglimbraidTestSigning :app:assembleRelease",
    "prepare:ios": "npm run build:web && node tools/prepare-ios.mjs",
    "prepare:android:release": "npm run build:web && node tools/prepare-android.mjs --release"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.2",
    "@capacitor/ios": "6.2.2",
    "capacitor-plugin-cdv-purchase": "13.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
